map
  # 12 6 -> aware range 26x14 (2*viewport+2) -> 23x11 tiles visiveis.
  # A margem de 3 nao e folga: mapview.cpp:428 faz drawDimension = visible + 3,
  # entao o maximo desenhavel e aware-3. O classico confirma: 15=18-3, 11=14-3.
  # O servidor precisa casar: Map::maxClientViewportX/Y em server/src/map.h.
  viewport: 12 6
  extended-view-ui: true
  max-z: 15
  sea-floor: 7
  underground-floor: 8
  aware-underground-floor-range: 2
health-bar:
  # Marcacoes de escala sobre a barra de vida, para ler HP absoluto sem abrir
  # janela. Um corte fino por micro-step, um grosso por macro-step.
  micro-step: 100
  macro-step: 1000
  # Abaixo disto a barra fica lisa: marcar rat e coelho so polui.
  min-health: 200
  # Acima disto os cortes finos somem e sobram so os grossos.
  micro-limit: 3000
game_interface:
  splitterMarginBottom: 200
game_console:
  messageHistory:
UseIgnoreList: false
UseWhiteList: false
IgnorePrivateMessages: false
IgnoreYelling: false
IgnorePlayers:
WhitelistedPlayers:
terminal-window:
  poped: false
