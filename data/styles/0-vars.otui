// Colors
&var-text-color: #ebbf90
&var-text-cip-color-white: #ebbf90
&var-text-cip-color-highlight: #ebbf90
&var-text-cip-color-grey: #a87f68
&var-text-cip-color: #ebbf90
&var-cip-inactive-color: #6b4d40
&var-text-cip-color-green: #44ad25
&var-text-color-disabled: #ebbf9088
&var-text-cip-color-orange: #ff9854
&var-text-cip-color-yellow: #ffda34
&var-text-cip-color-light-red: #f75f5f
&var-text-cip-color-blue: #1872c3
&var-text-cip-color-green-disabled: #255f15
&var-text-cip-store-disabled: #565656
&var-text-cip-store-red: #D33C3C
&var-text-cip-store-red-disabled: #6d2626
&var-text-cip-store-sale: #ffda34
&var-text-cip-store-sale-disabled: #6f5f18
&var-text-cip-store-timed: #1872c3
&var-text-cip-store-timed-disabled: #183f63
&var-textlist-selected: #33231d
&var-textlist-even: #281b17
&var-textlist-odd: #2c1e19


// Labels

&var-main-font: verdana-11px-antialised
&var-cip-font: silkscreen-16

// Seis variantes usadas em .otui mas nunca definidas - o mesmo bug latente que
// &var-cip-font tinha: o OTML resolve para string vazia e UIWidget::setFont cai
// em getDefaultFont(), ou seja, Verdana. Ficavam fora da skin sem ninguem notar.
// Nao existe uma silkscreen estreita, arredondada ou com contorno (o atlas de
// texto esta cheio, ver Atlas::init), entao todas apontam para a mesma fonte:
// o que elas realmente pediam era "a fonte da UI".
&var-cip-font-new: silkscreen-16
&var-cip-font-off: silkscreen-16
&var-cip-font-rounded: silkscreen-16
&var-cip-font-lowspace: silkscreen-16
&var-cip-font-outline: silkscreen-16
&var-text-cip-font: silkscreen-16
&var-cip-main-font: silkscreen-16
&var-cip-font-wheel: Verdana Bold-11px-wheel
&var-cip-font-mono-rounded: verdana-11px-mono-rounded
&var-cip-font-rounded-lowspace: verdana-11px-rounded-lowspace
